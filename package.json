{
  "name": "dsh-cheso-design",
  "version": "0.1.3-rc.0",
  "description": "Turn your ideas, files, and research into stunning presentations, posters, videos, and more. Create, edit, and share with Cheso",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./assets/icon-512.png",
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "docs",
    "assets",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "screenshots.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.2.2-0 || >=0.2.2-rc.1 <0.3.0-0"
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.1 <0.2.2-0 || >=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.19.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.3"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cheso",
    "ppt",
    "slides",
    "presentation",
    "poster",
    "video"
  ],
  "author": "Cheso",
  "license": "MIT",
  "homepage": "https://cheso.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheso-ai-platform/dsh-cheso-design.git"
  },
  "bugs": {
    "url": "https://github.com/cheso-ai-platform/dsh-cheso-design/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
